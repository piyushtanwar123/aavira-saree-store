# PostgreSQL connection used by the application and Drizzle.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Optional real WhatsApp business number with country code, digits only.
# Leave empty to show the configuration notice and enquiry form.
WHATSAPP_NUMBER=""

# Optional browser-test URL; defaults to http://localhost:3000.
TEST_BASE_URL="http://localhost:3000"
